# Zero-GPU compute-frame template for signed IAA adapter actions.
#SBATCH --job-name=@@JOB_NAME@@
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=@@CPUS_PER_TASK@@
#SBATCH --mem=@@MEMORY@@
#SBATCH --time=@@TIME@@
#SBATCH --output=@@LOG_DIR@@/%x-%j.out
#SBATCH --error=@@LOG_DIR@@/%x-%j.err
#SBATCH --open-mode=append
@@REQUEUE_DIRECTIVE@@
@@SBATCH_EXTRA@@
set -euo pipefail
export NCCL_DEBUG=INFO
export LOGLEVEL=INFO
export HOME=/tmp
export PYTHONPATH=/patches
export HF_HOME=/cache/huggingface
export XDG_CACHE_HOME=/cache
export IAA_COMPUTE_FRAME=slurm
if [ -n "@@ENV_FILE@@" ]; then
  trap 'shred -u "@@ENV_FILE@@" 2>/dev/null || rm -f "@@ENV_FILE@@"' EXIT
  set -a
  source "@@ENV_FILE@@"
  set +a
fi
@@EXTRA_ENV@@
srun --container-image=@@IMAGE@@ \
     --container-env=HF_HOME,HOME,IAA_COMPUTE_FRAME,PYTHONPATH,XDG_CACHE_HOME \
     --container-mounts=@@CONTAINER_MOUNTS@@ \
     @@COMMAND@@
