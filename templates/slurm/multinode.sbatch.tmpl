# TAO MULTI-NODE SLURM launch template — the single-node template's strict
# superset: same skeleton + a rank/master rendezvous block. tao-run-on-slurm
# renders it by substituting @@<NAME>@@; $SLURM_* stay literal.
#
# LOAD-BEARING: WORLD_SIZE is TAO's NODE COUNT (a misnomer — the container
# entrypoint reads WORLD_SIZE + NUM_GPU_PER_NODE and builds torchrun internally).
# Do NOT "correct" it to a global-rank count; that silently mis-shards training.
# EXTRA_ENV carries the cluster's NCCL knobs discovered by the NCCL probe (e.g.
# NCCL_P2P_DISABLE=1) — a wrong/empty value hangs the first collective for the
# entire distributed timeout with no error.
#SBATCH --job-name=@@JOB_NAME@@
#SBATCH --nodes=@@NUM_NODES@@
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:@@GPUS_PER_NODE@@
#SBATCH --cpus-per-task=@@CPUS_PER_TASK@@
#SBATCH --time=@@TIME@@
#SBATCH --wait-all-nodes=1
#SBATCH --output=@@LOG_DIR@@/%x-%j/main.out
#SBATCH --error=@@LOG_DIR@@/%x-%j/main.err
#SBATCH --open-mode=append
#SBATCH --requeue
@@SBATCH_EXTRA@@
set -euo pipefail
export NCCL_DEBUG=INFO
export LOGLEVEL=INFO

# Credentials via a mode-600 sidecar sourced + shredded — never inline on Lustre.
if [ -n "@@ENV_FILE@@" ]; then
  trap 'shred -u "@@ENV_FILE@@" 2>/dev/null || rm -f "@@ENV_FILE@@"' EXIT
  set -a
  source "@@ENV_FILE@@"
  set +a
fi

# Per-cluster NCCL env from the probe (e.g. NCCL_P2P_DISABLE=1, NCCL_SOCKET_IFNAME=eth0).
@@EXTRA_ENV@@

# Rendezvous — WORLD_SIZE = NODE COUNT (TAO convention), not global-rank count.
export WORLD_SIZE=@@NUM_NODES@@
export NUM_GPU_PER_NODE=@@GPUS_PER_NODE@@
export MASTER_PORT=29500
export MASTER_ADDR=$(scontrol show hostname "$SLURM_JOB_NODELIST" | head -1)
export NODE_RANK=$SLURM_NODEID

# Pyxis/Enroot will NOT create a missing --container-mounts source: it fails the
# whole container start with "enroot-mount: failed to mount: ... No such file or
# directory", which names the mount and not the missing directory. Docker's -v
# auto-creates one, so this gap stays invisible until a bundle runs on SLURM.
# results_dir is bound into the job record BEFORE launch, so it is known here
# and only needs materialising. The OUTPUT directory only: creating a missing
# INPUT would paper over unstaged data instead of failing on it.
# Unconditional -- the mount happens whether or not auto-resume is enabled.
mkdir -p "@@RESULTS_DIR@@"

# Auto-resume across a requeue. A requeued attempt re-runs THIS script with the
# spec frozen at submit time, so a resumable job would otherwise restart from
# epoch 0. Search only the declared results dir — a staged PTM or downloaded
# input must never masquerade as training state, which is why ptm/ and inputs/
# are pruned. Newest non-empty checkpoint wins. TAO_AUTO_RESUME=0 disables.
# @@RESUME_KEY@@ is the spec key for this network (e.g.
# train.resume_training_checkpoint_path); empty disables the block entirely.
RESUME_OVERRIDE=""
if [ -n "@@RESUME_KEY@@" ] && [ "${TAO_AUTO_RESUME:-1}" != "0" ]; then
  # Prefer real training state. A `best`/`latest` file is often written AFTER
  # the last epoch checkpoint, so newest-by-mtime alone would resume from a
  # metric-best snapshot or an alias and lose optimizer/scheduler position.
  # Fall back to them only when nothing else exists.
  # Newest wins. `ls -t` rather than find's -printf: -printf is GNU-only, and
  # because stderr is discarded here a BSD find would fail silently and disable
  # auto-resume without a word. -print0/xargs -0 keeps paths with spaces intact.
  RESUME_CKPT=$(find "@@RESULTS_DIR@@" \
      \( -type d \( -name ptm -o -name inputs \) -prune \) -o \
      \( -type f \( -name '*.pth' -o -name '*.ckpt' -o -name '*.tlt' \) \
         ! -iname '*best*' ! -iname '*latest*' \
         -size +0c -print0 \) 2>/dev/null \
    | xargs -0 ls -t 2>/dev/null | head -1)
  if [ -z "$RESUME_CKPT" ]; then
    RESUME_CKPT=$(find "@@RESULTS_DIR@@" \
        \( -type d \( -name ptm -o -name inputs \) -prune \) -o \
        \( -type f \( -name '*.pth' -o -name '*.ckpt' -o -name '*.tlt' \) \
           -size +0c -print0 \) 2>/dev/null \
      | xargs -0 ls -t 2>/dev/null | head -1)
  fi
  if [ -n "$RESUME_CKPT" ]; then
    RESUME_OVERRIDE="@@RESUME_KEY@@=$RESUME_CKPT"
    echo "auto-resume: continuing from $RESUME_CKPT" >&2
  fi
fi

# Wall-time self-requeue. `timeout` fires BEFORE SLURM's own --time, so the job
# exits cleanly and re-queues itself instead of dying in TIMEOUT state (which
# --requeue does not cover: it handles NODE_FAIL and pre-emption only). Paired
# with --open-mode=append so logs accumulate across attempts.
# `|| rc=$?` is required: `set -e` above would otherwise abort before the check.
rc=0
timeout "@@TIMEOUT_MINUTES@@m" srun --container-image=@@IMAGE@@ \
     --container-mounts=@@CONTAINER_MOUNTS@@ \
     @@COMMAND@@ $RESUME_OVERRIDE || rc=$?

if [ "$rc" -eq 124 ]; then
  echo "wall-time limit reached; requeueing $SLURM_JOB_ID" >&2
  scontrol requeue "$SLURM_JOB_ID"
  exit 0
fi
exit "$rc"
