{
  "version": 6,
  "workflow": "tao-run-deft-aoi-cosmos3",
  "started_at": "2026-08-27T00:00:00+00:00",
  "status": "in_progress",
  "kpi_target": "Accuracy >= 0.99",
  "metric_contract": {
    "name": "accuracy",
    "display_name": "Accuracy",
    "operator": ">=",
    "target": 0.99,
    "unit": "",
    "evaluator": {
      "type": "artifact",
