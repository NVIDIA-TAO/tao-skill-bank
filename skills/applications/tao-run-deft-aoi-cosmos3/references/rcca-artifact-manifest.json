{
  "schema_version": 2,
  "stage": "proxy_rcca",
  "artifact_classes": {
    "script_produced_required": [
      {
        "path": "gaps_summary.json",
        "state_field": "proxy_gaps_summary",
        "format": "json"
      },
      {
        "path": "gap_candidates.parquet",
        "state_field": "gap_candidates_parquet",
        "format": "parquet",
        "minimum_rows": 1
      },
      {
        "path": "selected_gaps.parquet",
        "state_field": "selected_gaps_parquet",
        "format": "parquet"
      }
    ],
    "agent_produced_required": [
      {
        "path": "RCCA_Report.md",
        "state_field": "rcca_report",
        "format": "markdown",
        "required_headings": [
          "Executive Summary",
          "Failure Mode Analysis",
          "Root Cause Analysis",
          "Corrective Actions",
          "Validation Plan"
        ]
      }
    ]
  }
}
