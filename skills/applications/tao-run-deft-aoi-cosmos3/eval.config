{
  "type": "plugin-workflow-eval",
  "plugin_name": "tao-skills",
  "plugin_source": ".",
  "skills_dir": [
    "skills/applications/tao-run-deft-aoi-cosmos3",
    "skills/models/tao-finetune-cosmos-reason",
    "skills/data/tao-mine-aoi-images",
    "skills/platform/tao-run-on-docker",
    "skills/core/tao-launch-workflow"
  ],
  "orchestrator_skill": "skills/applications/tao-run-deft-aoi-cosmos3",
  "evals": [
    {
      "id": "cosmos3-deft-bare-plan",
      "prompt": "Plan, but do not execute, a one-iteration Cosmos3 DEFT AOI run using bare OK/NG single-image ShareGPT annotations. Explain platform selection, preflight, Proxy/Benchmark isolation, real-image mining and assembly, state commits, and completion evidence.",
      "expected_outcome": "The plan selects no default platform, defaults to nvidia/Cosmos3-Nano unless another variant was explicitly requested, requires only Proxy/Benchmark/Mining single-image inputs, evaluates the frozen Benchmark gate before Proxy, uses Proxy only for RCCA and mining, creates train_iter_<N>.json only from selected Mining records and the previous iteration Train set, and tracks GPU stages through submit/status/logs/cancel with a job-record."
    },
    {
      "id": "cosmos3-deft-loop-mining",
      "prompt": "Run the full Cosmos3 DEFT AOI loop end-to-end as a one-iteration smoke test on single-image bare OK/NG subset data. Treat the Pre-Flight Summary as auto-approved. Execute Checkpoint Preparation, Baseline Benchmark Evaluate + KPI, Baseline Proxy Evaluate + RCCA when the gate is unmet, Routing, Data Mining, Assemble + Validate, Iter1 Training, and Iter1 Benchmark Evaluate + KPI. Continue until deft_state.json records top-level, baseline, and iter1 status as complete after loop_stop. The final write must be the required eval_report.md.",
      "expected_outcome": "The run completes without an approval prompt. Every annotation record contains exactly one image, Benchmark is frozen and evaluated before Proxy, Proxy alone drives routing and mining, train_iter_1.json contains only Mining records, split validation reports zero Train overlap with Proxy and Benchmark, and terminal state is recorded after loop_stop."
    }
  ],
  "credentials": [
    {
      "name": "HF_TOKEN",
      "description": "HuggingFace token, required only when the selected Cosmos Reason 3 checkpoint is not already staged."
    },
    {
      "name": "NGC_KEY",
      "description": "NGC API key, required only if an anonymous pull of a configured nvcr.io image is rejected."
    }
  ],
  "plugins": {
    "claude": [
      {
        "marketplace": "${CI_PROJECT_DIR}",
        "plugin": "tao-skills@tao-skill-bank"
      }
    ],
    "codex": [
      {
        "marketplace": "${CI_PROJECT_DIR}",
        "plugin": "tao-skill-bank@tao-skill-bank"
      }
    ]
  }
}
