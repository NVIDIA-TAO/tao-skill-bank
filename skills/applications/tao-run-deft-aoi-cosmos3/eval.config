{
  "skill": "tao-run-deft-aoi-cosmos3",
  "version": 2,
  "companions": [
    "skills/models/tao-finetune-cosmos-reason",
    "skills/data/tao-mine-aoi-images",
    "skills/platform/tao-run-on-docker",
    "skills/core/tao-launch-workflow"
  ],
  "validation_profile": {
    "platform": "docker",
    "gpu": "NVIDIA H200",
    "num_gpus": 1,
    "max_iterations": 5,
    "num_epochs": 10,
    "top_k_per_label": 15,
    "mining_mode": "filter_by_label",
    "mining_labels": ["OK", "NG"],
    "metric": "accuracy",
    "target": 0.99,
    "max_unknown_predictions": 0
  },
  "model": {
    "default_id": "nvidia/Cosmos3-Nano",
    "backend": "cosmos-framework",
    "base_path": "workspace/models",
    "base_format": "hf_vlm",
    "consume_directly": true
  },
  "actions": {
    "train": "cosmos-framework-train --sft-toml=/tao/config/train.toml",
    "evaluate": "cosmos-framework-evaluate --config /tao/config/evaluate.toml",
    "inference": "cosmos-framework-inference --model_path MODEL --type image --media IMAGE --prompt PROMPT --results_dir RESULTS"
  },
  "training_data_sources": ["mined_real_samples"],
  "contracts": ["bare_okng", "frozen_benchmark", "disk_state", "four_verbs", "job_record"]
}
