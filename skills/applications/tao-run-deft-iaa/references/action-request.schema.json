{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.nvidia.com/tao/schemas/iaa-action-request-v1.json",
  "title": "IAA DEFT platform action request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow",
    "controller_snapshot",
    "patches_snapshot",
    "platform",
    "name",
    "attempt",
    "label",
    "image_kind",
    "record_image",
    "workload_image",
    "gpu_ids",
    "passed_hf_token",
    "forward_env",
    "spec_bundle",
    "mounts",
    "environment",
    "virtualenv",
    "virtualenv_entrypoint_sha256",
    "virtualenv_shim",
    "results_dir",
    "stage_dir",
    "platform_runtime_dir",
    "status_path",
    "log_path",
    "fresh_outputs",
    "staging_absent_paths",
    "freshness_contract",
    "staging_receipt_path",
    "job_binding_path",
    "job_state_dir",
    "started_at",
    "started_ns",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "workflow": {"const": "tao-run-deft-iaa"},
    "runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "controller_snapshot": {"$ref": "#/$defs/snapshot"},
    "patches_snapshot": {"$ref": "#/$defs/snapshot"},
    "platform": {
      "enum": ["docker", "slurm", "kubernetes", "brev", "virtualenv", "airflow"]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    },
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "dispatch_repair": {"const": 1},
    "launcher_repair": {"const": 1},
    "unbound_replay": {"const": 1},
    "unbound_replay_evidence_sha256": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "train_output_replay": {"const": 1},
    "train_output_replay_evidence_sha256": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "label": {"type": "string", "pattern": "^(baseline|terminal|iter[1-9][0-9]*)$"},
    "image_kind": {"enum": ["pyt", "ds"]},
    "record_image": {"type": "string", "minLength": 1},
    "workload_image": {"type": "string", "minLength": 1},
    "gpu_ids": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "passed_hf_token": {"type": "boolean"},
    "forward_env": {
      "type": "array",
      "uniqueItems": true,
      "items": {"const": "HF_TOKEN"},
      "maxItems": 1
    },
    "spec_bundle": {"type": "object"},
    "mounts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "read_only"],
        "properties": {
          "source": {"type": "string", "pattern": "^/"},
          "target": {"type": "string", "pattern": "^/"},
          "read_only": {"type": "boolean"}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["HOME", "PYTHONPATH", "HF_HOME", "XDG_CACHE_HOME"],
      "properties": {
        "HOME": {"type": "string", "pattern": "^/"},
        "PYTHONPATH": {"type": "string", "pattern": "^/"},
        "HF_HOME": {"type": "string", "pattern": "^/"},
        "XDG_CACHE_HOME": {"type": "string", "pattern": "^/"},
        "LD_LIBRARY_PATH": {
          "const": "/usr/local/cuda/compat/lib.real:/usr/local/cuda/lib64"
        },
        "IAA_COMPUTE_FRAME": {
          "enum": ["docker", "slurm", "kubernetes", "brev", "virtualenv", "airflow"]
        },
        "OPENBLAS_NUM_THREADS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "OMP_NUM_THREADS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "MKL_NUM_THREADS": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "NUMEXPR_NUM_THREADS": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    },
    "cache_subset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "entries", "sha256"],
      "properties": {
        "root": {"type": "string", "pattern": "^/"},
        "entries": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "size", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "size": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "virtualenv": {"type": ["string", "null"]},
    "virtualenv_entrypoint_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "virtualenv_shim": {"type": "string", "pattern": "^/"},
    "results_dir": {"type": "string", "pattern": "^/"},
    "stage_dir": {"type": "string", "pattern": "^/"},
    "platform_runtime_dir": {"type": "string", "pattern": "^/"},
    "status_path": {"type": "string", "pattern": "^/"},
    "log_path": {"type": "string", "pattern": "^/"},
    "fresh_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "staging_absent_paths": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "freshness_contract": {
      "enum": [
        "local-mtime-after-prepare",
        "remote-mirror-with-delete-before-submit"
      ]
    },
    "staging_receipt_path": {"type": "string", "pattern": "^/"},
    "job_binding_path": {"type": "string", "pattern": "^/"},
    "job_state_dir": {"type": "string", "pattern": "^/"},
    "started_at": {"type": "string", "minLength": 1},
    "started_ns": {"type": "integer", "minimum": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "entries", "sha256"],
      "properties": {
        "root": {"type": "string", "pattern": "^/"},
        "entries": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "size", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "size": {"type": "integer", "minimum": 0},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["train_output_replay"]},
      "then": {
        "required": ["train_output_replay_evidence_sha256"],
        "properties": {
          "attempt": {"const": 2},
          "platform": {"const": "slurm"},
          "name": {"const": "train"}
        },
        "not": {
          "anyOf": [
            {"required": ["dispatch_repair"]},
            {"required": ["launcher_repair"]},
            {"required": ["unbound_replay"]}
          ]
        }
      },
      "else": {"not": {"required": ["train_output_replay_evidence_sha256"]}}
    },
    {
      "if": {"required": ["unbound_replay"]},
      "then": {
        "required": ["unbound_replay_evidence_sha256"],
        "properties": {"attempt": {"const": 2}},
        "not": {
          "anyOf": [
            {"required": ["dispatch_repair"]},
            {"required": ["launcher_repair"]}
          ]
        }
      },
      "else": {"not": {"required": ["unbound_replay_evidence_sha256"]}}
    },
    {
      "if": {"properties": {"platform": {"const": "virtualenv"}}},
      "then": {
        "properties": {
          "virtualenv": {"type": "string", "pattern": "^/"},
          "virtualenv_entrypoint_sha256": {
            "type": "string", "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "virtualenv": {"type": "null"},
          "virtualenv_entrypoint_sha256": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"name": {"enum": [
        "dataset_rebuild", "dataset_materialize", "gap_analysis",
        "mining_postprocess", "history_select", "visualize_prepare",
        "visualize_finish", "eval_config", "train_config",
        "publish_checkpoint", "iteration_summary", "metric_parse", "report",
        "sdg_normalize_repair"
      ]}}},
      "then": {
        "properties": {
          "environment": {"required": [
            "HOME", "PYTHONPATH", "HF_HOME", "XDG_CACHE_HOME", "IAA_COMPUTE_FRAME"
          ]},
          "gpu_ids": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "environment": {"not": {"required": ["IAA_COMPUTE_FRAME"]}},
          "gpu_ids": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"platform": {"const": "virtualenv"}}},
      "then": {
        "properties": {
          "freshness_contract": {"const": "local-mtime-after-prepare"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": {"enum": ["slurm", "kubernetes", "brev"]}
        }
      },
      "then": {
        "properties": {
          "freshness_contract": {
            "const": "remote-mirror-with-delete-before-submit"
          }
        }
      }
    }
  ]
}
