{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tao://artifacts/metric_record.schema.json",
  "title": "TAO AutoML metric record",
  "description": "Canonical result consumed by the SDK-free AutoML step loop. It replaces platform result-directory discovery and log-format guesses with an explicit metric identity, direction, job link, and declared artifacts.",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "rec_id",
    "job_id",
    "status",
    "primary_metric",
    "direction",
    "metrics",
    "artifacts",
    "failure",
    "measured_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "experiment_id": { "type": "string", "minLength": 1 },
    "rec_id": { "type": "string", "pattern": "^rec-[0-9]{4,}$" },
    "job_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["COMPLETE", "ERROR", "CANCELED"] },
    "primary_metric": { "type": "string", "minLength": 1 },
    "direction": { "enum": ["maximize", "minimize"] },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint_uri": { "type": "string", "minLength": 1 },
        "primary_uri": { "type": "string", "minLength": 1 },
        "metrics_uri": { "type": "string", "minLength": 1 },
        "output_uris": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "failure": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["class", "message"],
          "additionalProperties": false,
          "properties": {
            "class": { "enum": ["ERR_INFRA", "ERR_PROGRAM"] },
            "message": { "type": "string" }
          }
        }
      ]
    },
    "measured_at": { "type": "string", "minLength": 1 },
    "feedback": {}
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "COMPLETE" } }, "required": ["status"] },
      "then": {
        "properties": {
          "failure": { "type": "null" },
          "artifacts": {
            "anyOf": [
              { "required": ["checkpoint_uri"] },
              { "required": ["primary_uri"] },
              { "required": ["output_uris"] }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "ERROR" } }, "required": ["status"] },
      "then": {
        "properties": { "failure": { "type": "object" } }
      }
    }
  ]
}
